{
  "name": "gestao-loja-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend da aplicação Gestão Loja — integração Admin ↔ Loja com JWT, Prisma e testes Vitest.",
  "license": "MIT",

  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },

  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^3.23.8",
    "@prisma/client": "^5.22.0"
  },

  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/supertest": "^2.0.16",
    "@vitest/coverage-v8": "^2.1.9",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },

  "engines": {
    "node": ">=20.0.0"
  },

  "prisma": {
    "schema": "./prisma/schema.prisma"
  },

  "keywords": [
    "backend",
    "jwt",
    "vitest",
    "typescript",
    "prisma",
    "express",
    "gestao-loja"
  ]
}
